# API server environment template
# These values are read directly by Node.js via process.env.

NODE_ENV=development
PORT=21837
LOG_LEVEL=info
SESSION_SECRET=change-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tlis

# Required for AI generation
GEMINI_API_KEY=your-gemini-api-key

# Optional live providers (the server falls back gracefully when absent)
AHREFS_API_KEY=
AHREFS_TARGET=quiet-luxury.com
GSC_SITE_URL=https://example.com/
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
SEMRUSH_API_KEY=
