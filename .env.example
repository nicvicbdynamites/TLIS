# TLIS shared environment template
# Copy this file to .env (repo root) and fill in the values that apply to your deployment.
# Keep secrets out of version control; actual .env files are ignored by git.

# Core runtime
NODE_ENV=development
PORT=21837
LOG_LEVEL=info
BASE_PATH=/
SESSION_SECRET=change-me

# Local/Postgres database used by the API server (Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tlis

# Supabase (required for auth + cloud persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers
GEMINI_API_KEY=your-gemini-api-key

# Optional AI providers (gracefully ignored when absent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Research providers
AHREFS_API_KEY=
AHREFS_TARGET=quiet-luxury.com
GSC_SITE_URL=https://example.com/
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEMRUSH_API_KEY=

# Social integrations
TIKTOK_API_KEY=
INSTAGRAM_API_KEY=
YOUTUBE_API_KEY=
PINTEREST_API_KEY=
